# ComfyUI 进程要带的环境变量（k8s：容器的 env 或 envFrom 的 ConfigMap）。说明见 README「环境变量」。

# 必配：文本编码器走外置服务
TEXT_ENCODER_MODE=api
TEXT_ENCODER_URL=http://kimodo-textencoder.<namespace>.svc.cluster.local/

# 配了代理时：NO_PROXY 要按域名后缀盖住 TEXT_ENCODER_URL 的主机名（httpx 不认网段写法）
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,.svc,.svc.cluster.local
# no_proxy=localhost,127.0.0.1,.svc,.svc.cluster.local

# Hugging Face 连不上时：第一次用某个模型要下载权重
# HF_ENDPOINT=https://hf-mirror.com
